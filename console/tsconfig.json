{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shared/mark": ["src/shared/mark.tsx", "../src/components/anvil/mark.tsx"],
      "react/jsx-runtime": ["node_modules/@types/react/jsx-runtime.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
